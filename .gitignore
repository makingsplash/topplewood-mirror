# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/[Ii][Oo][Ss].meta
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/[Aa]ndroid.meta

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*


# Playphoria custom ignores
.idea/
.aiassistant/*
!.aiassistant/rules/
Assets.index
Assets.index.meta
*.blend1
*.blend1.meta
.vsconfig
BotReports/
/[Aa]ssets/[Ss]ay[Kk]it/
!/[Aa]ssets/[Ss]ay[Kk]it[Pp]ackage/saykit.unitypackage
/[Aa]ssets/[Bb]uild[Rr]eports/

mono_crash.*.json


# MacOS Related meta files
.DS_Store
*.orig
*.rej

/fastlane/.env
/fastlane/.env.*
.vscode/
Assets/BuildReports.meta
Assets/SayKit.meta
[Tt]emp
[Tt]emp.meta
ServerData/
EditorData/LevelPreviews
Assets/Game/Tools/MiroTools/Config/MiroToolsConfig.asset
Assets/Game/Tools/MiroTools/Config/MiroToolsConfig.asset.meta
Assets/Game/Tools/MiroTools/Editor/Config/LevelsTableConfig.asset
Assets/Game/Tools/MiroTools/Editor/Config/LevelsTableConfig.asset.meta
Assets/Game/Tools/MiroTools/Config.meta
Assets/Game/Tools/MiroTools/Config
SimulationReports/*
.junie/*
!.junie/guidelines.md
.claude/settings.local.json
.claude/.DS_Store

# .NET build artifacts
tools/LevelValidator/bin/
tools/LevelValidator/obj/

# Python cache
__pycache__/
*.pyc

# Отчёты сим-харнесса (level-sim). Генерируемые, десятки МБ, живут в sim-worktree;
# в основном дереве появляются от ручного прогона. Скоуп коммита кодовых ролей широкий —
# без этой строки многомегабайтный JSON однажды уедет в коммит роли.
/[Aa]rtifacts/
Assets/Editor/McpBridge
Assets/Editor/McpBridge.meta
Assets/Plugins/Demigiant/DOTween/Editor/DOTweenUpgradeManager.XML.meta
Assets/Plugins/Demigiant/DOTween/Editor/DOTweenUpgradeManager.dll
Assets/Plugins/Demigiant/DOTween/Editor/DOTweenUpgradeManager.dll.meta
Assets/Plugins/Demigiant/DOTween/Editor/DOTweenUpgradeManager.XML

# Signing material — must not be committed to the template (add per-game locally / via CI secrets)
/androidcerts/
/ioscerts/
*.keystore
*.mobileprovision
*.p12
*.jks

# Секреты дашборда (CLAUDE_CODE_OAUTH_TOKEN и пр.) — только локально, в git НИКОГДА.
.env.local
.env.*.local
# Любой производный файл секрета (.bak/.old/копия редактора) — тоже секрет:
# правила выше НЕ матчат .env.local.bak, и он тихо уезжал в коммит.
.env.local*
.studio/.orchestrator-hold
# Дайджест задачи для прогона роли — генерируется дашбордом перед каждым запуском, в git не нужен.
.studio/tasks/*/CONTEXT.md

# Витрина скиллов — симлинки, производные от `skills_on` в .studio/config.yml
# (собирает .studio/tools/skills.sh). Склад `_off/` versioned, витрина — нет.
.claude/skills/*
!.claude/skills/_off/

# маркеры живых вотчеров прогонов (runtime, TASK-359-инцидент): .studio/.watching/<TASK>.<pid>
.studio/.watching/

# Локальная отметка сверки мета-слоя с шаблоном студии (template-sync.py ack) — состояние машины,
# а не проекта: у каждого дерева своя.
.studio/.template-sync.json

# Промежуточные картинки ролей в папках задач — НА ДИСКЕ (гейт смотрит их там, в слот их переносит cpSync дашборда),
# в git НЕ идут. Решение владельца 2026-10-21 при чистке LFS (.studio/audits/2026-10-21-history-rewrite.md):
# гейтовые кадры, кропы, рендеры и сырые генерации. Арт-паки (`art/`), вложения владельца `OWNER-*` и референсы
# коммитятся как раньше. Куда роли кладут промежуточное — соглашение в .claude/commands/studio-run.md, шаг 4.
.studio/tasks/*/frames*/
.studio/tasks/*/crops*/
.studio/tasks/*/renders/
.studio/tasks/**/raw/

# ПРОИЗВОДНОЕ SayKit-ПРЕБИЛДА — в git не идёт (снято с учёта 2026-10-21, TASK-064; образец — Piecework TASK-012).
# Пребилд берёт это из ответа сервера по ключу приложения (`SayKitApp.APP_KEY_ANDROID`) и ПЕРЕЗАПИСЫВАЕТ на каждом
# прогоне (`CheckRemoteConfigs`, `ConfigureGenerateFiles`), а `RemoveObsoleteSayKitFiles` в его начале удаляет все
# `Assets/Resources/**/saykit_*`. Внутри — ключи Firebase, Facebook, AdMob, то есть закоммиченная копия и устаревает
# молча, и принадлежит ЧУЖОМУ приложению: до TASK-064 здесь лежали google-services.json от `color-tile-sort-stack-puzzle`
# (пакет `com.game.tilesort`), strings.xml третьего приложения и ответ сервера под ключом `ctlsrta`.
# Без файлов на диске редактор на Play шумит «Settings asset is missing» — лечение локально, без сети:
# docs/platform/saykit.md (SayKitAppSettingsImporter.TrySynchronizeSettingsAsset). Сборка пребилдом пишет всё сама.
# Появится в Assets/Plugins/ настоящий, не генерируемый плагин — сузить правила до имён файлов.
Assets/Plugins/Android.meta
Assets/Plugins/Android/
Assets/Plugins/iOS.meta
Assets/Plugins/iOS/
Assets/Resources/SayKit.meta
Assets/Resources/SayKit/
